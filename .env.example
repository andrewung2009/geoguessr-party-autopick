# Copy this file to .env, or just run: npm run setup
#
# 1. DISCORD_TOKEN
#    https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste_your_bot_token_here

# 2. ALLOWED_DISCORD_USER_IDS
#    Your own Discord user ID(s), comma separated.
#    In Discord: right-click your name -> Copy User ID (enable Developer Mode first).
ALLOWED_DISCORD_USER_IDS=123456789012345678

# 3. BRIDGE_SECRET
#    Shared password between the local bridge and the Tampermonkey script.
#    Generate one with:
#      node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BRIDGE_SECRET=paste_a_long_random_secret_here

# 4. BRIDGE_PORT
#    Local only. Change if something else already uses 8787.
BRIDGE_PORT=8787
